    },
    {
      "name": "tmux",
      "check": [
        "tmux",
        "-V"
      ],
      "why": "OpenRig runs each seat in a tmux session"
    },
    {
      "name": "Claude Code",
      "check": [
        "claude",
        "--version"
      ],
      "why": "runtime of the PM lead and the implementer; your login, never packaged"
    },
    {
      "name": "Codex",
      "check": [
        "codex",
        "--version"
      ],
      "version_pattern": "codex-cli (\\d+\\.\\d+\\.\\d+)",
      "min": "0.159.0",
      "why": "runtime of QA and the dogfood tester; your login, never packaged"
    }
  ],
  "permissions": [
    {
      "runtime": "codex",
      "files": [
        ".codex/config.toml",
        ".codex/rules/openrig.rules"
      ],
      "effect": "Commands that start with `rig` run outside the Codex sandbox without asking, so QA and the dogfood tester can hand work on. Every other command stays in the workspace-write sandbox with no network. Without these files the Codex seats cannot reach the OpenRig daemon.",
      "tested": null
    }
  ],
  "first_job": "rig send pm-lead@product-pm \"New request: requests/task-board.md. Scope it and run it through the factory.\"",
